# ============================================================================
# ToolForge configuration
#
#   cp .env.example .env      then fill in the keys you actually use
#   toolforge doctor          verifies everything below is wired up
#
# The file is loaded automatically — you do not need to `export` anything.
# ============================================================================

# ---------------------------------------------------------------- providers
# Fill in whichever you use. Several keys can be comma-separated; ToolForge
# rotates through them and moves to the next one when a key starts failing.

OPENAI_API_KEY=sk-your-openai-key
# OPENAI_API_KEY=sk-key-1,sk-key-2,sk-key-3

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Endpoints. Leave the defaults for the official APIs; override to point at
# Azure, a gateway, OpenRouter, or a local vLLM server.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ------------------------------------------------------------------- models
# The provider is inferred from the model id (claude-* -> Anthropic, otherwise
# OpenAI-compatible). Force it with a prefix: anthropic:… or openai:…
#
#   Anthropic  claude-opus-5 · claude-sonnet-5 · claude-haiku-4-5
#   OpenAI     gpt-5.1 · gpt-5.1-mini · gpt-5 · gpt-4.1 · gpt-4o
#
# Routing a Claude model through an OpenAI-compatible gateway instead of the
# native API:  GENERATION_MODEL=openai:claude-sonnet-5

# Writes the dialogues (stages 1-3).
GENERATION_MODEL=gpt-5.1

# Scores them (stage 4). Worth using your strongest model here — it decides
# what reaches the training set.
JUDGE_MODEL=claude-opus-5

# ----------------------------------------------------------------- sampling
TEMPERATURE=0.0
MAX_TOKENS=8192

# ------------------------------------------------------------- throughput
# Parallel in-flight requests. Lower it if you hit rate limits.
CONCURRENCY=8

# Attempts per key before rotating; delay doubles up to RETRY_MAX_DELAY.
RETRY_ATTEMPTS=5
RETRY_DELAY=5
RETRY_MAX_DELAY=60
REQUEST_TIMEOUT=180

# ------------------------------------------------------------------- paths
# TOOL_BANK_DIR=./tool_bank
# OUTPUT_DIR=./output

# ---------------------------------------------------------------- retrieval
# How many passages a simulated tool response returns (a random count in range).
RAG_TOP_K_MIN=5
RAG_TOP_K_MAX=10

# How many distractor tools sit alongside the gold tool in the prompt.
VIRTUAL_TOOL_MIN=3
VIRTUAL_TOOL_MAX=8

# ------------------------------------------------- stage 1 only (optional)
# Local sentence-transformers model for the variant similarity gate.
#   python download_data.py --with-model
# Without it stage 1 still runs, but every candidate variant is accepted.
# EMBEDDING_MODEL_PATH=./models/bge-m3
